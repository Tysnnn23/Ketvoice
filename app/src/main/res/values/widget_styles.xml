<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 7.4 widgets (Apple Music-like): the type of « En cours » and « En cours + contrôles ». Colours are set by
         WidgetViews from the cover; the values here are the picker preview's. -->
    <style name="WidgetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WidgetArtist" parent="WidgetTitle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">#BFFFFFFF</item>
        <item name="android:layout_marginTop">3dp</item>
    </style>
    <style name="WidgetTime">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">#BFFFFFFF</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
    </style>
    <style name="WidgetGlyph">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">9dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">#FFFFFFFF</item>
    </style>
</resources>
